# ─────────────────────────────────────────────────────────────
#  .env.example — ШАБЛОН. Реальные значения вписывать НЕ сюда,
#  а в ENV хостинга (Railway/VPS) или в локальный .env (он в .gitignore).
#  Этот файл коммитится в репозиторий ПУСТЫМ — без секретов.
# ─────────────────────────────────────────────────────────────

# === Telegram ===
TELEGRAM_BOT_TOKEN=            # токен из @BotFather — вписать в ENV хостинга, НЕ сюда
TELEGRAM_SALES_CHAT_ID=-5481376613   # chat_id рабочей группы продаж
ADMIN_USER_ID=989604210       # ID администратора (админ-команды бота — только ему)
TELEGRAM_WEBHOOK_SECRET=      # случайная строка, напр.: openssl rand -hex 24

# Публичный адрес сервиса для set_webhook (на Railway можно опустить — возьмём
# из RAILWAY_PUBLIC_DOMAIN). Напр.: https://audit.hrustalni.com
PUBLIC_BASE_URL=
# Ставить ли webhook автоматически при старте (true/false). По брифу деплой и
# set_webhook требуют подтверждения — на первый деплой можно поставить false.
SET_WEBHOOK_ON_STARTUP=true

# === Хранение лидов ===
# На старте — только Telegram (карточка в группу), таблица не нужна.
# Фаза 2 (по согласованию локализации ПДн) — один из вариантов:
GOOGLE_SERVICE_ACCOUNT_JSON=  # base64 от JSON сервис-аккаунта Google
SHEET_ID=                     # ID гугл-таблицы лидов
# DATABASE_URL=               # альтернатива: база на РФ-хостинге (строгое 152-ФЗ)

# === Сайт и аналитика ===
ALLOWED_ORIGIN=https://audit.hrustalni.com   # домен лендинга (поправить под фактический)
YM_ID=                        # номер счётчика Яндекс.Метрики
CONSENT_VERSION=2026-06-24    # версия текста согласия (для 152-ФЗ)

# === Анти-спам / прочее ===
RATE_LIMIT_MAX=5              # макс. заявок с одного IP за окно
RATE_LIMIT_WINDOW_SEC=600     # окно rate-limit, сек
DATA_DIR=data                 # каталог локального лога согласий

# === Опционально ===
UNISENDER_API_KEY=            # автоответ на e-mail после заявки (если нужно)
